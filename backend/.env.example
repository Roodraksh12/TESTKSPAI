# Backend FastAPI — copy to backend/.env and fill values

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
OPENROUTER_API_KEY=
# Use a live OpenRouter slug, e.g. openrouter/free or openai/gpt-oss-20b:free
OPENROUTER_MODEL=openrouter/free
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP (when empty, invite/reset emails are logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_PUBLIC_URL=http://localhost:5173
TEMP_PASSWORD_TTL_HOURS=48

# Bootstrap Police IT (seed account; Administration-first home)
BOOTSTRAP_BADGE_ID=KA-IT-0001
BOOTSTRAP_PASSWORD=demo1234
