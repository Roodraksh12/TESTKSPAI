# Backend FastAPI — copy to backend/.env and fill values

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI backend. "openrouter" preserves the existing setup.
AI_PROVIDER=openrouter
AI_REQUEST_TIMEOUT_SECONDS=90
# External providers receive only backend-tokenised content. Set "disabled" to
# prohibit all external LLM calls. Never set AI_PRIVATE_ENDPOINT=true unless the
# OpenAI-compatible endpoint is actually inside an approved private boundary.
AI_EXTERNAL_MODE=redacted_only
AI_PRIVATE_ENDPOINT=false
AI_MAX_EGRESS_CHARACTERS=60000
AI_PRIVACY_AUDIT_REQUIRED=false
AI_CHAT_RETENTION_DAYS=30
OPENROUTER_API_KEY=
# Keep this true for real or sensitive data. A demo may temporarily set it to
# false only when using synthetic records and a free model without a ZDR route.
OPENROUTER_ZDR_REQUIRED=true
OPENROUTER_MODEL=openrouter/free

# Used only when AI_PROVIDER=openai_compatible. AI_BASE_URL may be a base URL
# ending in /v1 or the full /chat/completions URL. AI_API_KEY may be empty for
# an authenticated private network/local endpoint that does not require one.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP (when empty, invite/reset emails are logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_PUBLIC_URL=http://localhost:5173
TEMP_PASSWORD_TTL_HOURS=48

# Bootstrap Police IT (seed account; Administration-first home)
BOOTSTRAP_BADGE_ID=KA-IT-0001
BOOTSTRAP_PASSWORD=demo1234
