generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CommandRange {
  id        String     @id @default(cuid())
  name      String
  districts District[]
  officers  Officer[]  @relation("OfficerCommandRange")
}

model District {
  id             String            @id @default(cuid())
  name           String
  commandRangeId String?
  commandRange   CommandRange?     @relation(fields: [commandRangeId], references: [id])
  stations       PoliceStation[]
  ranges         Range[]
  officerLinks   OfficerDistrict[]
}

model Range {
  id         String          @id @default(cuid())
  name       String
  districtId String
  district   District        @relation(fields: [districtId], references: [id])
  stations   PoliceStation[]
  officers   Officer[]       @relation("OfficerRange")
}

model PoliceStation {
  id         String    @id @default(cuid())
  name       String
  districtId String
  rangeId    String?
  district   District  @relation(fields: [districtId], references: [id])
  range      Range?    @relation(fields: [rangeId], references: [id])
  officers   Officer[]
  cases      Case[]
  alerts     Alert[]
}

model OfficerDistrict {
  officerId  String
  districtId String
  officer    Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@id([officerId, districtId])
}

enum Role {
  POLICE_IT
  DGP_IGP
  ADGP
  IGP
  DIG
  SP
  ADDL_SP_DCP
  ASP_ACP
  DYSP
  SHO
  INSPECTOR
  SI
  ASI
  HEAD_CONSTABLE
  CONSTABLE
}

enum OfficerStatus {
  PENDING_INVITE
  MUST_CHANGE_PASSWORD
  ACTIVE
  DISABLED
}

enum ResetRequestStatus {
  PENDING
  FULFILLED
  REJECTED
}

model Officer {
  id                 String         @id @default(cuid())
  badgeId            String         @unique
  passwordHash       String
  name               String
  role               Role
  stationId          String?
  email              String?
  districtId         String?
  rangeId            String?
  commandRangeId     String?
  reportingOfficerId String?
  hierarchyPath      String // Postgres ltree; stored as text in Prisma
  status             OfficerStatus  @default(ACTIVE)
  createdById        String?
  station            PoliceStation? @relation(fields: [stationId], references: [id])
  range              Range?         @relation("OfficerRange", fields: [rangeId], references: [id])
  commandRange       CommandRange?  @relation("OfficerCommandRange", fields: [commandRangeId], references: [id])
  reportingOfficer   Officer?       @relation("OfficerReports", fields: [reportingOfficerId], references: [id])
  reports            Officer[]      @relation("OfficerReports")
  createdBy          Officer?       @relation("OfficerCreatedBy", fields: [createdById], references: [id])
  createdOfficers    Officer[]      @relation("OfficerCreatedBy")
  districts          OfficerDistrict[]
  chatSessions       ChatSession[]
  auditLogs          AuditLog[]
  feedbacks          Feedback[]
  alertReads         AlertRead[]
  invitationsSent    Invitation[]   @relation("InvitedBy")
  invitationsRecv    Invitation[]   @relation("InvitedOfficer")
  resetRequests      PasswordResetRequest[] @relation("ResetOfficer")
  resetsFulfilled    PasswordResetRequest[] @relation("ResetFulfilledBy")

  currentIoCases     Case[]         @relation("CaseCurrentIO")
  authoredDiaryEntries CaseDiaryEntry[] @relation("DiaryEntryAuthor")
}

model Invitation {
  id               String    @id @default(cuid())
  invitedOfficerId String
  invitedById      String
  tempPasswordHash String
  expiresAt        DateTime
  usedAt           DateTime?
  channel          String    @default("email")
  createdAt        DateTime  @default(now())
  invitedOfficer   Officer   @relation("InvitedOfficer", fields: [invitedOfficerId], references: [id])
  invitedBy        Officer   @relation("InvitedBy", fields: [invitedById], references: [id])
}

model PasswordResetRequest {
  id            String             @id @default(cuid())
  officerId     String
  requestedAt   DateTime           @default(now())
  status        ResetRequestStatus @default(PENDING)
  fulfilledById String?
  fulfilledAt   DateTime?
  officer       Officer            @relation("ResetOfficer", fields: [officerId], references: [id])
  fulfilledBy   Officer?           @relation("ResetFulfilledBy", fields: [fulfilledById], references: [id])
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  CHARGESHEETED
  CLOSED
}

model Case {
  id               String       @id @default(cuid())
  firNumber        String       @unique
  stationId        String
  station          PoliceStation @relation(fields: [stationId], references: [id])
  crimeType        String
  status           CaseStatus   @default(OPEN)
  incidentDate     DateTime
  reportedDate     DateTime     @default(now())
  latitude         Float?
  longitude        Float?
  summary          String?
  rawExtractedText String?
  chargesheetDraft String?
  createdFromScan  Boolean      @default(false)
  
  casePersons      CasePerson[]
  connections      Connection[]
  chatSessions     ChatSession[]
  matches          CaseMatch[]  @relation("CaseMatches")
  matchedBy        CaseMatch[]  @relation("MatchedCases")
  
  currentIoId      String?
  currentIo        Officer?     @relation("CaseCurrentIO", fields: [currentIoId], references: [id])
  diaryEntries     CaseDiaryEntry[]
  evidence         Evidence[]
  documents        Document[]
}

enum PersonRole {
  ACCUSED
  VICTIM
  WITNESS
}

model Person {
  id          String       @id @default(cuid())
  name        String
  role        PersonRole
  phone       String?
  address     String?
  
  casePersons CasePerson[]
  connectionsA Connection[] @relation("PersonA")
  connectionsB Connection[] @relation("PersonB")
  caseMatches  CaseMatch[]
  
  custodyStartDate DateTime?
  evidence         EvidencePerson[]
  diaryEntries     DiaryEntryPerson[]
}

model CasePerson {
  id       String     @id @default(cuid())
  caseId   String
  personId String
  role     PersonRole
  
  case   Case   @relation(fields: [caseId], references: [id])
  person Person @relation(fields: [personId], references: [id])
}

enum RelationType {
  CO_ACCUSED
  SAME_ADDRESS
  SAME_PHONE
  PRIOR_CASE_TOGETHER
}

model Connection {
  id             String       @id @default(cuid())
  personAId      String
  personBId      String
  relationType   RelationType
  sourceCaseId   String?
  
  personA   Person @relation("PersonA", fields: [personAId], references: [id])
  personB   Person @relation("PersonB", fields: [personBId], references: [id])
  sourceCase Case? @relation(fields: [sourceCaseId], references: [id])
}

enum MatchStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model CaseMatch {
  id              String      @id @default(cuid())
  caseId          String
  matchedCaseId   String?
  matchedPersonId String?
  confidenceScore Float
  status          MatchStatus @default(PENDING)
  reason          String?
  
  case          Case    @relation("CaseMatches", fields: [caseId], references: [id])
  matchedCase   Case?   @relation("MatchedCases", fields: [matchedCaseId], references: [id])
  matchedPerson Person? @relation(fields: [matchedPersonId], references: [id])
}

model ChatSession {
  id           String        @id @default(cuid())
  officerId    String
  activeCaseId String?
  createdAt    DateTime      @default(now())
  
  officer      Officer       @relation(fields: [officerId], references: [id])
  activeCase   Case?         @relation(fields: [activeCaseId], references: [id])
  messages     ChatMessage[]
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  role          MessageRole
  content       String
  sourceCaseIds String[]    @default([])
  createdAt     DateTime    @default(now())
  
  session  ChatSession @relation(fields: [sessionId], references: [id])
  feedback Feedback?
}

model AuditLog {
  id         String   @id @default(cuid())
  officerId  String
  action     String
  targetType String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())
  
  officer Officer @relation(fields: [officerId], references: [id])
}

enum AlertType {
  HOTSPOT
  ANOMALY
}

model Alert {
  id              String        @id @default(cuid())
  stationId       String
  type            AlertType
  zoneLabel       String
  riskScore       Float
  reason          String
  fingerprint     String?       @unique
  latitude        Float?
  longitude       Float?
  crimeType       String?
  severity        String        @default("MEDIUM")
  status          String        @default("ACTIVE")
  source          String        @default("LEGACY")
  action          String?
  evidence        Json          @default("{}")
  firstDetectedAt DateTime      @default(now())
  lastDetectedAt  DateTime      @default(now())
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  
  station PoliceStation @relation(fields: [stationId], references: [id])
  reads   AlertRead[]
}

model AlertRead {
  officerId String
  alertId   String
  readAt    DateTime @default(now())

  officer Officer @relation(fields: [officerId], references: [id], onDelete: Cascade)
  alert   Alert   @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([officerId, alertId])
}

enum Rating {
  UP
  DOWN
}

model Feedback {
  id         String      @id @default(cuid())
  messageId  String      @unique
  officerId  String
  rating     Rating
  comment    String?
  createdAt  DateTime    @default(now())
  
  message ChatMessage @relation(fields: [messageId], references: [id])
  officer Officer     @relation(fields: [officerId], references: [id])
}

model CaseDiaryEntry {
  id           String      @id @default(cuid())
  caseId       String
  pageNumber   Int
  authorId     String
  activityType String
  narrative    String
  timestamp    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  
  case         Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author       Officer     @relation("DiaryEntryAuthor", fields: [authorId], references: [id])
  
  evidence     DiaryEntryEvidence[]
  persons      DiaryEntryPerson[]
  documents    Document[]
}

enum EvidenceType {
  PHOTO
  VIDEO
  VOICE
  FORENSIC
  MISC
}

model Evidence {
  id           String        @id @default(cuid())
  caseId       String
  type         EvidenceType
  description  String
  addedById    String
  status       String        @default("ACTIVE")
  timestamp    DateTime      @default(now())
  
  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  addedBy      Officer       @relation(fields: [addedById], references: [id])
  
  diaryEntries DiaryEntryEvidence[]
  documents    Document[]
  persons      EvidencePerson[]
}

model Document {
  id           String          @id @default(cuid())
  caseId       String
  name         String
  path         String
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now())
  
  diaryEntryId String?
  evidenceId   String?
  
  case         Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  diaryEntry   CaseDiaryEntry? @relation(fields: [diaryEntryId], references: [id], onDelete: SetNull)
  evidence     Evidence?       @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
}

model DiaryEntryEvidence {
  diaryEntryId String
  evidenceId   String
  
  diaryEntry   CaseDiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  evidence     Evidence       @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  
  @@id([diaryEntryId, evidenceId])
}

model DiaryEntryPerson {
  diaryEntryId String
  personId     String
  
  diaryEntry   CaseDiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  person       Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  @@id([diaryEntryId, personId])
}

model EvidencePerson {
  evidenceId String
  personId   String
  
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  @@id([evidenceId, personId])
}

